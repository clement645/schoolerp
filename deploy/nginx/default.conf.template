# Serves the web application and forwards /api to the API container.
#
# TLS is expected to terminate in front of this container (a load balancer or
# a host-level reverse proxy), which should also send
# `Strict-Transport-Security`. ${API_UPSTREAM} is substituted at start-up.

upstream edumaster_api {
  server ${API_UPSTREAM};
  keepalive 16;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  # Uploads are limited to 10 MB by the API; leave room for multipart overhead.
  client_max_body_size 12m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    proxy_pass http://edumaster_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Replaces, rather than extends, whatever the client sent: the API trusts
    # exactly one hop (TRUST_PROXY_HOPS=1) and must see the real peer address.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    # API responses carry personal data: never stored by Nginx.
    proxy_no_cache 1;
    proxy_cache_bypass 1;
  }

  # Fingerprinted build output never changes under the same name.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Everything else is the single-page application; the entry page itself is
  # always revalidated so a new release is picked up at once.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}

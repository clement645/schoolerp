# EduMaster Pro — production configuration for docker-compose.prod.yml
#
# Copy to `.env.production`, replace every `change-me-*` value with a long
# random secret (for example `openssl rand -base64 36`), and keep the file out
# of version control. The API refuses to start while a placeholder remains.

# The address people open in their browser. Used for CORS and cookies.
PUBLIC_URL=https://school.example.com

# Where the web container listens on the host. Put a TLS proxy in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# One hop for the bundled Nginx; add one per further proxy in front of it.
TRUST_PROXY_HOPS=1

# ── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-jwt-access
COOKIE_SECURE=true
SWAGGER_ENABLED=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=edumaster
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=edumaster

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# The bundled gateway by default; set S3_ENDPOINT to use an external service.
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false
S3_BUCKET=edumaster
S3_ACCESS_KEY=edumaster
S3_SECRET_KEY=change-me-s3-secret

# ── M-Pesa (optional) ────────────────────────────────────────────────────────
# Leave all of these empty to run without M-Pesa. Set all of them to enable
# it; production refuses to start against Safaricom's sandbox.
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# The public https address of this installation; Safaricom calls it back.
MPESA_CALLBACK_BASE_URL=
# At least 32 URL-safe characters, e.g. `openssl rand -hex 24`.
MPESA_CALLBACK_SECRET=

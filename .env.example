# EduMaster Pro — environment configuration
#
# Run `npm run setup` to create a local `.env` from this file with randomly
# generated credentials. Never commit `.env`. Values marked `change-me-*` are
# placeholders and are rejected by the API's environment validation.

# ── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV is deliberately not set here: Vite reads this file too, and a value
# in it would force development mode into production web builds. The API
# defaults to `development`; deployments set NODE_ENV in the real environment.

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5180
# Swagger UI at /api/docs. Defaults to off in production when unset.
SWAGGER_ENABLED=true

# ── Authentication ───────────────────────────────────────────────────────────
# Signs access tokens. At least 32 characters; rotate to sign everyone out.
JWT_ACCESS_SECRET=change-me-jwt-access
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie over HTTPS only. Defaults to true in production when unset.
# COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10

# ── Web ──────────────────────────────────────────────────────────────────────
WEB_PORT=5180
# Only VITE_-prefixed variables are exposed to the browser bundle.
VITE_API_BASE_URL=/api/v1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=edumaster
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=edumaster
POSTGRES_PORT=5434
DATABASE_URL=postgresql://edumaster:change-me-postgres@127.0.0.1:5434/edumaster?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6381
REDIS_URL=redis://:change-me-redis@127.0.0.1:6381

# ── Object storage (S3-compatible) ───────────────────────────────────────────
# Local development uses the `storage` container; in production point these at any
# S3-compatible service. Files are private and served only through the API.
S3_PORT=9100
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=edumaster
S3_ACCESS_KEY=edumaster
S3_SECRET_KEY=change-me-s3-secret
# Path-style addressing suits self-hosted gateways; set to false for AWS S3.
S3_FORCE_PATH_STYLE=true

# ── Deployment ───────────────────────────────────────────────────────────────
# Reverse proxies in front of the API (0 when clients connect directly).
TRUST_PROXY_HOPS=0
# Prefix of rate-limit counters in Redis.
RATE_LIMIT_NAMESPACE=edumaster

# ── M-Pesa (Safaricom Daraja, optional) ──────────────────────────────────────
# Leave empty to run without M-Pesa. To try it, create a sandbox app at
# https://developer.safaricom.co.ke and set every value below. Payments are
# credited only on Safaricom's confirmation; nothing is simulated.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public https address that forwards to this API (e.g. a tunnel in development).
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
